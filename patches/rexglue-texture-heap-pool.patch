+bool D3D12TextureCache::AllocateTexturePages(uint32_t page_count, uint32_t& heap_index_out,
+                                             uint32_t& first_page_out) {
+  if (!page_count || page_count > kTextureHeapPages) {
+    return false;
+  }
+  for (size_t i = 0; i <= texture_heaps_.size(); ++i) {
+    if (i == texture_heaps_.size()) {
+      auto new_heap = std::make_unique<TextureHeap>();
+      const ui::d3d12::D3D12Provider& provider = command_processor_.GetD3D12Provider();
+      D3D12_HEAP_DESC heap_desc = {};
+      heap_desc.SizeInBytes = uint64_t(kTextureHeapPages) << kTextureHeapPageSizeLog2;
+      heap_desc.Properties = ui::d3d12::util::kHeapPropertiesDefault;
+      heap_desc.Alignment = D3D12_DEFAULT_RESOURCE_PLACEMENT_ALIGNMENT;
+      heap_desc.Flags =
+          D3D12_HEAP_FLAG_ALLOW_ONLY_NON_RT_DS_TEXTURES | provider.GetHeapFlagCreateNotZeroed();
+      if (FAILED(provider.GetDevice()->CreateHeap(&heap_desc, IID_PPV_ARGS(&new_heap->heap)))) {
+        return false;
+      }
+      texture_heaps_.push_back(std::move(new_heap));
+    }
+    TextureHeap& heap = *texture_heaps_[i];
+    if (heap.free_pages < page_count) {
+      continue;
+    }
+    uint32_t run = 0;
+    for (uint32_t page = 0; page < kTextureHeapPages; ++page) {
+      if (!(page & 63) && heap.used[page >> 6] == ~uint64_t(0)) {
+        run = 0;
+        page += 63;
+        continue;
+      }
+      if ((heap.used[page >> 6] >> (page & 63)) & 1) {
+        run = 0;
+        continue;
+      }
+      if (++run == page_count) {
+        uint32_t first = page + 1 - page_count;
+        for (uint32_t p = first; p <= page; ++p) {
+          heap.used[p >> 6] |= uint64_t(1) << (p & 63);
+        }
+        heap.free_pages -= page_count;
+        heap_index_out = uint32_t(i);
+        first_page_out = first;
+        return true;
+      }
+    }
+  }
+  return false;
+}
+
+void D3D12TextureCache::FreeTexturePages(uint32_t heap_index, uint32_t first_page,
+                                         uint32_t page_count) {
+  TextureHeap& heap = *texture_heaps_[heap_index];
+  for (uint32_t p = first_page; p < first_page + page_count; ++p) {
+    heap.used[p >> 6] &= ~(uint64_t(1) << (p & 63));
+  }
+  heap.free_pages += page_count;
 }
 
