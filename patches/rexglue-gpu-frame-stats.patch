+/**
+ * @file        gpu_frame_stats.h
+ * @brief       Cumulative GPU command processor counters for the host app.
+ *
+ * The rexgpu-xenos plugin exports `rex_gpu_frame_stats()`; an app fetches it with
+ * GetProcAddress(GetModuleHandle("rexgpu-xenos.dll"), "rex_gpu_frame_stats") and diffs snapshots
+ * (window title fps/draws/triangles, per-frame hitch breakdowns). Every field only grows; the
+ * command processor thread writes them with relaxed atomics, so a reader sees each field
+ * consistently but not all fields at one instant.
+ */
+
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+
+namespace rex::graphics {
+
+struct GpuFrameStats {
+  uint32_t size;  // sizeof(GpuFrameStats), for layout checks across builds
+  std::atomic<uint64_t> swaps;          // IssueSwap calls
+  std::atomic<uint64_t> draws;          // host draws issued
+  std::atomic<uint64_t> triangles;      // triangles of those draws (guest primitive + index count)
+  std::atomic<uint64_t> copies;         // resolves (EDRAM copies)
+  std::atomic<uint64_t> pipelines;      // pipeline cache misses (new pipeline states)
+  std::atomic<uint64_t> shaders;        // shader translations (any thread)
+  std::atomic<uint64_t> texture_loads;  // texture (re)loads from guest memory
+  std::atomic<uint64_t> upload_bytes;   // shared memory bytes uploaded from guest memory
+  // Command processor thread time, nanoseconds.
+  std::atomic<uint64_t> ns_idle;          // waiting for the guest to write commands
+  std::atomic<uint64_t> ns_draw;          // IssueDraw total (includes pipeline, textures, copies, most uploads)
+  std::atomic<uint64_t> ns_pipeline;      // ConfigurePipeline (shader translation, PSO creation)
+  std::atomic<uint64_t> ns_textures;      // RequestTextures (texture creation, loads, untiling)
+  std::atomic<uint64_t> ns_shared_memory; // shared memory uploads from guest memory
+  std::atomic<uint64_t> ns_copy;          // IssueCopy (resolves)
+  std::atomic<uint64_t> ns_fence_wait;    // blocked on host GPU fences (CheckSubmissionFence)
+  std::atomic<uint64_t> ns_swap;          // IssueSwap
+  // Appended later.
+  std::atomic<uint64_t> texture_creates;     // new host texture resources
+  std::atomic<uint64_t> ns_texture_create;   // creating them (inside ns_textures)
+  std::atomic<uint64_t> ns_texture_load;     // loading / untiling texture data (inside ns_textures)
+  std::atomic<uint64_t> wait_reg_mem_sleeps; // WAIT_REG_MEM sleeps (guest-requested GPU waits)
+  std::atomic<uint64_t> ns_wait_reg_mem;     // WAIT_REG_MEM polling until the value matched
+  // CPU writes to GPU-watched guest memory (mostly write-watch faults on guest threads).
+  std::atomic<uint64_t> invalidations;
+  std::atomic<uint64_t> ns_invalidation;
+};
+
+GpuFrameStats& gpu_frame_stats();
+
+// Adds the time from construction to destruction to a GpuFrameStats field.
+class GpuStatsTimer {
+ public:
+  explicit GpuStatsTimer(std::atomic<uint64_t>& field) : field_(field), start_(Now()) {}
+  ~GpuStatsTimer() { field_.fetch_add(Now() - start_, std::memory_order_relaxed); }
+  static uint64_t Now();
+
+ private:
+  std::atomic<uint64_t>& field_;
+  uint64_t start_;
+};
+
+// Exported from rexgpu-xenos.dll (defined in command_processor.cpp):
+//   extern "C" const rex::graphics::GpuFrameStats* rex_gpu_frame_stats();
+using GpuFrameStatsFn = const GpuFrameStats* (*)();
+
+}  // namespace rex::graphics
