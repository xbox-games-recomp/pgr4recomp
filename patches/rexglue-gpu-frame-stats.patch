+// Triangles in a guest draw, for gpu_frame_stats (lines, points and patches count as none).
+static uint64_t GuestDrawTriangleCount(xenos::PrimitiveType type, uint32_t index_count) {
+  switch (type) {
+    case xenos::PrimitiveType::kTriangleList:
+    case xenos::PrimitiveType::kTriangleWithWFlags:
+      return index_count / 3;
+    case xenos::PrimitiveType::kRectangleList:
+      return index_count / 3 * 2;
+    case xenos::PrimitiveType::kQuadList:
+      return index_count / 4 * 2;
+    case xenos::PrimitiveType::kTriangleFan:
+    case xenos::PrimitiveType::kTriangleStrip:
+    case xenos::PrimitiveType::kPolygon:
+    case xenos::PrimitiveType::k2DTriStrip:
+      return index_count >= 3 ? index_count - 2 : 0;
+    case xenos::PrimitiveType::kQuadStrip:
+      return index_count >= 4 ? (index_count - 2) / 2 * 2 : 0;
+    default:
+      return 0;
+  }
+}
