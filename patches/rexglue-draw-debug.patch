+// pgr4_crowd_cull: PGR4's skinned world vertex shader (ucode hash 72EE8062BF5E764A) draws instances of
+// index / c55.y vertices; each vertex is skinned by one bone, palette entry = vertex byte (vf95 dword
+// 5, .x) + c[55 + a0].x, a0 = instance * c255.x, in the vf94 palette of 3 x half4 rows. The game's crowd
+// members come out with bones hundreds of units apart, so their triangles span the scene (empty
+// grandstands, flickering sky wedges). Returns true if any instance of the draw is like that. Bones
+// with float16 exponent-31 translations (the game's "hidden" marker) are ignored.
+static bool Pgr4CrowdDrawBroken(const RegisterFile& regs, const uint8_t* physical_base,
+                                const uint16_t* indices, uint32_t index_count) {
+  xenos::xe_gpu_vertex_fetch_t f95 = regs.GetVertexFetch(95), f94 = regs.GetVertexFetch(94);
+  auto c = [&](uint32_t i, uint32_t comp) {
+    float v;
+    std::memcpy(&v, &regs.values[XE_GPU_REG_SHADER_CONSTANT_000_X + 4 * i + comp], 4);
+    return v;
+  };
+  float verts_per_instance = c(55, 1), consts_per_instance = c(255, 0);
+  uint32_t max_index = 0;
+  for (uint32_t i = 0; i < index_count; ++i) {
+    uint16_t v = uint16_t((indices[i] >> 8) | (indices[i] << 8));
+    if (v != 0xFFFF) max_index = std::max<uint32_t>(max_index, v);
+  }
+  uint32_t instances =
+      verts_per_instance >= 1.0f ? uint32_t(float(max_index) / verts_per_instance) + 1 : 1;
+  uint64_t bone_mask[4] = {};
+  uint32_t vb_vertices = (f95.size << 2) / 28;
+  const uint8_t* vb = physical_base + (f95.address << 2);
+  for (uint32_t v = 0; v < vb_vertices; ++v) {
+    uint32_t raw;
+    std::memcpy(&raw, vb + v * 28 + 20, 4);
+    uint32_t b = xenos::GpuSwap(raw, f95.endian) & 0xFF;
+    bone_mask[b >> 6] |= uint64_t(1) << (b & 63);
+  }
+  float limit = float(REXCVAR_GET(pgr4_crowd_cull_spread));
+  float t[256][3];
+  for (uint32_t inst = 0; inst < instances && inst < 64; ++inst) {
+    uint32_t a0 = uint32_t(float(inst) * consts_per_instance + 0.5f);
+    if (55 + a0 >= 256) break;
+    uint32_t base = uint32_t(c(55 + a0, 0));
+    uint32_t count = 0;
+    for (uint32_t b = 0; b < 256; ++b) {
+      if (!(bone_mask[b >> 6] & (uint64_t(1) << (b & 63)))) continue;
+      uint32_t entry = (f94.address << 2) + (base + b) * 24;
+      if (entry + 24 > SharedMemory::kBufferSize) continue;
+      bool hidden = false;
+      for (uint32_t r = 0; r < 3; ++r) {
+        uint32_t d;
+        std::memcpy(&d, physical_base + entry + (2 * r + 1) * 4, 4);
+        d = xenos::GpuSwap(d, f94.endian);
+        hidden |= ((d >> 10) & 31) == 31;
+        t[count][r] = HalfToFloat(uint16_t(d & 0xFFFF));
+      }
+      if (!hidden) ++count;
+    }
+    if (count < 2) continue;
+    for (uint32_t axis = 0; axis < 3; ++axis) {
+      float col[256];
+      for (uint32_t i = 0; i < count; ++i) col[i] = t[i][axis];
+      std::nth_element(col, col + count / 2, col + count);
+      float median = col[count / 2];
+      for (uint32_t i = 0; i < count; ++i) {
+        if (std::abs(t[i][axis] - median) > limit) return true;
+      }
+    }
+  }
+  return false;
+}
